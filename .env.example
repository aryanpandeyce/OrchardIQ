# Environment Configuration for OrchardIQ
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage & Warehouse
DATA_DIR=data
WAREHOUSE_DIR=data/warehouse
DOCS_DIR=docs/knowledge_base
UNSTRUCTURED_DIR=data/unstructured
DUCKDB_DATABASE_PATH=data/warehouse/orchard_dw.duckdb
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# AWS S3 Configuration (Optional - for remote Parquet lakehouse)
# S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
# S3_BUCKET=orchardiq-lakehouse-prod
# S3_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# LLM & Agent Configuration (Phase 2+)
ANTHROPIC_API_KEY=
MOCK_LLM_MODE=true

# Security & Governance
JWT_SECRET_KEY=orchardiq_dev_secret_change_in_production_key_32chars
ANALYST_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=30
